{
  "name": "tremplin-en-coulisses",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "crawl": "node --env-file-if-exists=.env scripts/crawl.mjs",
    "index": "node --env-file-if-exists=.env scripts/index.mjs",
    "refresh": "npm run crawl && npm run index",
    "test": "node --test tests/*.test.mjs",
    "supabase:inspect": "node --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local scripts/supabase.mjs inspect",
    "supabase:push": "node --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local scripts/supabase.mjs push",
    "start:supabase": "NODE_ENV=production RAG_BACKEND=supabase node --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local server/index.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.6",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
