generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Profile {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique
  password_hash              String
  first_name                 String
  last_name                  String
  street_address             String?
  city                       String?
  postal_code                String?
  phone                      String?
  role                       String    @default("user") // "admin" | "user"
  accepted_privacy_policy    Boolean   @default(false)
  privacy_policy_accepted_at DateTime?
  // Vérification de l'adresse email (obligatoire avant de candidater). Les comptes historiques sont considérés vérifiés.
  email_verified_at          DateTime?
  email_verification_token   String?   @unique
  email_verification_sent_at DateTime?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  applications          Application[]
  password_reset_tokens PasswordResetToken[]

  @@map("profiles")
}

model Application {
  id                       String    @id @default(uuid()) @db.Uuid
  user_id                  String    @db.Uuid
  // Édition (année de la finale) à laquelle la candidature est rattachée.
  edition                  Int       @default(2026)
  application_type         String // "solo" | "group"
  stage_name               String
  group_members            Json?
  biography                String
  musical_style            String
  instagram                String?
  how_did_you_hear         String?
  has_original_composition Boolean   @default(false)
  is_sacem_registered      Boolean?
  allows_broadcast         Boolean   @default(false)
  has_stage_experience     Boolean   @default(false)
  stage_experience_details String?
  preferred_audition_date  String?
  accepted_rules           Boolean   @default(false)
  status                   String    @default("pending") // "pending" | "validated" | "rejected"
  time_slot_id             String?   @unique @db.Uuid
  // Résultat des auditions : finaliste (sélectionné) ou non ; date d'envoi de l'email de résultat.
  is_finalist              Boolean   @default(false)
  result_sent_at           DateTime?
  // Rappels automatiques envoyés avant l'audition (J-7 et J-1).
  reminder_j7_sent_at      DateTime?
  reminder_j1_sent_at      DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  profile                 Profile                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  time_slot               TimeSlot?               @relation(fields: [time_slot_id], references: [id])
  technical_sheet         TechnicalSheet?
  parental_authorizations ParentalAuthorization[]
  audition_tracking       AuditionTracking?

  @@unique([user_id, edition])
  @@index([edition])
  @@map("applications")
}

model TimeSlot {
  id           String   @id @default(uuid()) @db.Uuid
  edition      Int      @default(2026)
  date         String // stored as "YYYY-MM-DD"
  start_time   String // stored as "HH:MM"
  end_time     String // stored as "HH:MM"
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())

  application Application?

  @@index([edition, date])
  @@map("time_slots")
}

model TechnicalSheet {
  id             String   @id @default(uuid()) @db.Uuid
  application_id String   @unique @db.Uuid
  pdf_url        String?
  // Form fields (if filled via form instead of PDF upload)
  sound_engineer String?
  instruments    Json?
  microphones    Json?
  monitoring     String?
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("technical_sheets")
}

/// Archive des fiches techniques en doublon supprimées par la migration de septembre 2026 (pour nettoyage des fichiers).
model TechnicalSheetPurged {
  id             String   @id @db.Uuid
  application_id String   @db.Uuid
  pdf_url        String?
  sound_engineer String?
  instruments    Json?
  microphones    Json?
  monitoring     String?
  notes          String?
  created_at     DateTime
  updated_at     DateTime

  @@map("technical_sheets_purged")
}

model ParentalAuthorization {
  id             String   @id @default(uuid()) @db.Uuid
  application_id String   @db.Uuid
  member_index   Int      @default(0)
  member_name    String?
  pdf_url        String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, member_index])
  @@map("parental_authorizations")
}

model AuditionTracking {
  id             String    @id @default(uuid()) @db.Uuid
  application_id String    @unique @db.Uuid
  has_arrived    Boolean   @default(false)
  arrived_at     DateTime?
  is_checked_in  Boolean   @default(false)
  checked_in_at  DateTime?
  has_performed  Boolean   @default(false)
  performed_at   DateTime?
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("audition_tracking")
}

/// Configuration de la saison en cours (une seule ligne).
model ScheduleConfig {
  id                     String    @id @default(uuid()) @db.Uuid
  // Édition en cours (année de la finale), ex. 2027.
  edition                Int       @default(2026)
  // Fenêtre d'inscription. Null = pas de borne.
  registration_opens_at  DateTime?
  registration_closes_at DateTime?
  // Dates d'audition ("YYYY-MM-DD"), utilisées pour les créneaux et le choix de date préférée.
  audition_dates         String[]  @default([])
  // Date de référence pour le calcul de l'âge ("YYYY-MM-DD"). Null = dernière date d'audition.
  age_reference_date     String?
  is_validated           Boolean   @default(false)
  venue                  String?   @default("Espace Léo Ferré, Brest")
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@map("schedule_config")
}

model SmtpConfig {
  id              String   @id @default(uuid()) @db.Uuid
  smtp_host       String
  smtp_port       Int      @default(587)
  smtp_username   String
  smtp_password   String
  smtp_from_email String
  smtp_from_name  String   @default("Tremplin Jeunes en Scène")
  smtp_secure     Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("smtp_config")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  profile_id String   @db.Uuid
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@map("password_reset_tokens")
}

/// Journal léger pour la limitation de débit (connexion, mot de passe oublié, inscription).
model RateLimitHit {
  id         String   @id @default(uuid()) @db.Uuid
  key        String
  created_at DateTime @default(now())

  @@index([key, created_at])
  @@map("rate_limit_hits")
}

/// Modèles d'emails personnalisés par l'administration (une ligne par modèle ; absent = texte par défaut du code).
model EmailTemplate {
  key        String   @id
  subject    String
  body       String
  updated_at DateTime @updatedAt

  @@map("email_templates")
}

/// Configuration du site vitrine (une seule ligne) : mode d'affichage et bandeau d'annonce.
model VitrineConfig {
  id              String   @id @default(uuid()) @db.Uuid
  // "preseason" | "auditions" | "finale" | "aftermath"
  mode            String   @default("finale")
  // Édition affichée en modes finale / après la finale (null = édition de la saison en cours).
  edition         Int?
  banner_enabled  Boolean  @default(false)
  banner_text     String?
  banner_url      String?
  // Texte d'explication affiché en mode auditions (le site sert de page d'explication).
  auditions_intro String?
  // Accroche affichée en mode avant-ouverture.
  preseason_text  String?
  updated_at      DateTime @updatedAt

  @@map("vitrine_config")
}

/// Finale, palmarès et après-finale d'une édition (site vitrine).
model VitrineEdition {
  edition              Int       @id
  anniversary_label    String?
  final_date           DateTime?
  final_venue          String?
  final_address        String?
  final_city           String?
  ticket_url           String?
  pass_culture_url     String?
  price_label          String?
  jury_prize_text      String?
  public_prize_text    String?
  jury_winner          String?
  public_winner        String?
  aftermath_text       String?
  aftermath_video_url  String?
  aftermath_photos_url String?
  // [{ id, name, genre, description, image, youtubeId }]
  finalists            Json      @default("[]")
  // [{ date, name, city, url }]
  tour_dates           Json      @default("[]")
  updated_at           DateTime  @updatedAt

  @@map("vitrine_editions")
}

model VitrinePartner {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  logo_url   String
  url        String?
  position   Int      @default(0)
  is_active  Boolean  @default(true)
  updated_at DateTime @updatedAt

  @@map("vitrine_partners")
}

/// Images du site vitrine envoyées depuis l'administration (stockées sur Vercel Blob, servies par /api/vitrine/media/[id]).
model VitrineMedia {
  id           String   @id @default(uuid()) @db.Uuid
  blob_url     String
  content_type String
  filename     String
  created_at   DateTime @default(now())

  @@map("vitrine_media")
}
